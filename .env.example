# Public production API origin. A trailing slash is not required.
NEXT_PUBLIC_API_URL=https://api.wolvcapital.com

# Canonical public frontend origin.
NEXT_PUBLIC_SITE_URL=https://www.wolvcapital.com

# WalletConnect project identifier used by RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional BSCScan API key for chain statistics. The app has a fallback when absent.
BSCSCAN_API_KEY=

# Optional client/API compatibility setting used by selected integrations.
NEXT_PUBLIC_API_BASE_URL=

# Optional server-only Telegram integration settings. Keep these secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local development overrides:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
